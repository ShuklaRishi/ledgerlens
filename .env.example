# Copy to .env and fill in. .env is gitignored; never commit keys.

# --- LLM: Gemini free tier (key from https://aistudio.google.com/apikey) --------
GEMINI_API_KEY=
# Free tier, both 15 requests/min and 500/day (AI Studio, Sep 2026). 3.1 answered in ~10 s;
# gemini-3.5-flash-lite took 25-80 s per call on the free tier (measured).
LLM_MODEL=gemini-3.1-flash-lite
LLM_THINKING_LEVEL=low
# Stay under the per-minute cap; the agent makes 3 model calls per question.
LLM_REQUESTS_PER_MINUTE=12

# Embeddings run locally (fastembed / ONNX), so retrieval needs no API key.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Agent -------------------------------------------------------------------
# AGENT_VERSION: v1 = the agent as first shipped (every failure mode on); v2 = fixed.
AGENT_VERSION=v2
# FAILURE_MODE puts single failure modes back into v2 (comma list), to study one at a time:
# fanout_join | skipped_visualisation | hallucinated_column | date_boundary | wrong_route | all
FAILURE_MODE=none

# --- Tracing (OpenTelemetry, OpenInference conventions) -----------------------
# The local Arize Phoenix from docker-compose: trace UI and OTLP receiver. Empty = tracing off.
PHOENIX_URL=http://localhost:6006
# Optional second exporter to Neatlogs over OTLP/gRPC. Untested (needs an account) and
# needs `uv sync --extra neatlogs`.
NEATLOGS_API_KEY=

# --- Database (docker-compose reads these too) --------------------------------
PG_PORT=5433
# Owner password: used by `make seed` only, never by the agent.
POSTGRES_PASSWORD=postgres
AGENT_RO_PASSWORD=agent_ro
AGENT_DATABASE_URL=postgresql://agent_ro:agent_ro@localhost:5433/pagila
ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/pagila
